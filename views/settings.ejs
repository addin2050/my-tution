<%- include('partials/head', {title: 'Settings'}) %>
<h1>Settings</h1>

<form class="card" method="post" action="/settings/center">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Center</h2>
  <label>Center name</label><input name="center_name" value="<%= settings.center_name %>" required>
  <label>Address (shown on receipts)</label><input name="center_address" value="<%= settings.center_address %>">
  <div class="row three">
    <div><label>Phone</label><input name="center_phone" value="<%= settings.center_phone %>"></div>
    <div><label>Currency symbol</label><input name="currency" value="<%= settings.currency %>" maxlength="4"></div>
    <div><label>Billing starts from</label><input type="month" name="academic_start" value="<%= settings.academic_start %>" required></div>
  </div>
  <p class="small muted">Monthly fees are billed from this month (or the student's own start month, whichever is later).</p>
  <button class="btn">Save</button>
</form>

<form class="card" method="post" action="/settings/fees">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Classes and monthly fees</h2>
  <p class="small muted">Untick <b>Show</b> to hide a division you don't use. It disappears from every dropdown and list. A class with active students can't be hidden. Fee changes apply to months billed from now on; fees already billed keep their original amount.</p>
  <% [...new Set(classes.map(c => c.grade))].forEach(g => { %>
    <h3 style="margin:1rem 0 0;font-size:.95rem">Class <%= g %></h3>
    <div class="row" style="grid-template-columns:repeat(4,1fr)">
      <% classes.filter(c => c.grade === g).forEach(c => { %><div><label><%= c.grade %><%= c.division %></label><input type="number" min="0" step="1" inputmode="numeric" name="fee_<%= c.id %>" value="<%= c.monthly_fee %>">
        <label style="display:flex;gap:.4rem;align-items:center;margin:.3rem 0 0;color:var(--text)"><input type="checkbox" name="show_<%= c.id %>" value="1" <%= c.active ? 'checked' : '' %> style="width:auto;min-height:0"> Show</label></div><% }) %>
    </div>
  <% }) %>
  <p><button class="btn">Save classes &amp; fees</button></p>
</form>

<div class="card">
  <h2>Teacher logins</h2>
  <p class="small muted">Teachers can only mark attendance. They cannot see fees.</p>
  <ul class="list">
    <% users.forEach(u => { %>
      <li><div class="grow"><b><%= u.username %></b><span class="small muted"><%= u.role %></span></div>
      <% if (u.role === 'teacher') { %>
        <form method="post" action="/settings/teachers/<%= u.id %>/delete" onsubmit="return confirm('Remove this teacher login?')" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm danger">Remove</button></form>
      <% } %></li>
    <% }) %>
  </ul>
  <form method="post" action="/settings/teachers">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row two">
      <div><label>New teacher username</label><input name="username" autocapitalize="none" required></div>
      <div><label>Password (8+ characters)</label><input name="password" type="password" minlength="8" autocomplete="new-password" required></div>
    </div>
    <p><button class="btn secondary">Add teacher</button></p>
  </form>
</div>

<form class="card" method="post" action="/settings/password">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Change my password</h2>
  <div class="row two">
    <div><label>Current password</label><input name="current" type="password" autocomplete="current-password" required></div>
    <div><label>New password (8+ characters)</label><input name="next" type="password" minlength="8" autocomplete="new-password" required></div>
  </div>
  <p><button class="btn secondary">Change password</button></p>
</form>

<form class="card" method="post" action="/settings/promote" onsubmit="return confirm('Promote every active student to the next class?')">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Year-end promotion</h2>
  <p class="small muted">Moves every student up one class (1→2 … 9→10, same division) and marks grade 10 students as graduated. Do this once, at the start of the new year. Back up first.</p>
  <label>Type PROMOTE to confirm</label><input name="confirm" autocomplete="off">
  <p><button class="btn danger">Promote students</button></p>
</form>
<%- include('partials/foot') %>
